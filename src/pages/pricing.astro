---
import Base from "../layouts/Base.astro";
import CtaPair from "../components/CtaPair.astro";
import FinalCta from "../components/FinalCta.astro";
import PageHero from "../components/PageHero.astro";
import PricingGrid from "../components/PricingGrid.astro";

const title = "AI Receptionist Pricing | Launchline Design";
const description =
  "Starter is $497 setup and $197 a month. Growth is $1,497 and $497 a month. Custom AI starts at $3,500 and $997 a month. Usage at cost. Free 14-day Starter pilot.";
---

<Base title={title} description={description}>
  <PageHero
    eyebrow="Miami · USD"
    title="Simple packages. Your quote is confirmed on the call."
    lede="Done-for-you AI that answers, follows up, and books for your business 24/7. Start small, see it work on your own calls, and grow into custom AI systems built around how you operate."
    crumbs={[
      { href: "/", label: "Home" },
      { href: "/pricing", label: "Pricing" },
    ]}
  >
    <CtaPair />
  </PageHero>

  <section class="section">
    <div class="wrap">
      <PricingGrid />
    </div>
  </section>
  <FinalCta />
</Base>
