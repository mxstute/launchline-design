---
import Base from "../layouts/Base.astro";
import CtaPair from "../components/CtaPair.astro";
import FinalCta from "../components/FinalCta.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const title = "About Myles Stute | Launchline Design";
const description =
  "Launchline Design is a Miami AI studio founded by Myles Stute, who also runs Magic City Services. You work directly with the person who builds the system.";
---

<Base title={title} description={description}>
  <PageHero
    eyebrow="Miami"
    title="You work directly with the engineer."
    lede="Launchline Design is Myles Stute’s studio for done-for-you AI. Receptionists, follow-up, and custom systems for local businesses. Based in Miami. Built for Miami-Dade."
    crumbs={[
      { href: "/", label: "Home" },
      { href: "/about", label: "About" },
    ]}
  >
    <CtaPair />
  </PageHero>

  <section class="section">
    <div class="wrap founder">
      <div class="photo-slot">
        <p class="slot-kicker">Photo</p>
        <strong>Portrait of {site.founder}</strong>
        <p>Add a real photo here. No stock stand-in.</p>
      </div>
      <div class="stack">
        <h2>Myles Stute</h2>
        <p>
          Myles founded Launchline Design in Miami. He also runs {site.otherBusiness}, a home services business in the same city. The missed call is not a hypothetical. It is what happens when the person who should answer is on a job.
        </p>
        <p>
          Small or large, you work directly with the engineer. The scoping call, the script, the launch, and the monthly tune are the same person. There is no handoff to an account manager who did not hear your calls.
        </p>
        <p>
          This site does not list a client roster, a star rating, or a count of systems shipped. Those will be published only when a client agrees to be named. Until then the <a href="/#proof">proof section</a> stays empty on purpose.
        </p>
        <p>
          Office: <a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
          · <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap cards">
      <article class="panel">
        <h3>What Launchline does</h3>
        <p>AI receptionists, missed-call text-back, review and follow-up automation, and custom systems from a single chatbot to a full intake workflow.</p>
      </article>
      <article class="panel">
        <h3>Who it is for</h3>
        <p>Miami home services, law firms, med spas, and dental practices. English first. Spanish as an add-on on Starter and Growth, and included on Custom.</p>
      </article>
      <article class="panel">
        <h3>What it will not pretend</h3>
        <p>No fabricated reviews, no borrowed client logos, and no promise of a specific number of booked jobs. The quote on the call is the price.</p>
      </article>
    </div>
  </section>
  <FinalCta />
</Base>
