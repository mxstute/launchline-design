---
import Base from "../../layouts/Base.astro";
import CtaPair from "../../components/CtaPair.astro";
import FinalCta from "../../components/FinalCta.astro";
import PageHero from "../../components/PageHero.astro";
import { industries, type Industry } from "../../data/industries";

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
---

<Base title={industry.title} description={industry.description}>
  <PageHero
    eyebrow={industry.eyebrow}
    title={industry.h1}
    lede={industry.lede}
    crumbs={[
      { href: "/", label: "Home" },
      { href: `/industries/${industry.slug}`, label: industry.name },
    ]}
  >
    <CtaPair loomHref="/demo#custom-demo" />
  </PageHero>

  <section class="section">
    <div class="wrap stack" style="max-width: 44rem">
      {industry.story.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="scenario-heading">
    <div class="wrap">
      <h2 id="scenario-heading" class="section-head">Calls this is built to take</h2>
      <div class="scenario-grid">
        {
          industry.scenarios.map((scenario) => (
            <article class="panel">
              <h3>{scenario.title}</h3>
              <p style="margin-top: 0.45rem">{scenario.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap handle-grid">
      <article>
        <h3>The AI handles</h3>
        <ul class="plain-list">
          {industry.handles.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <h3>A person handles</h3>
        <ul class="plain-list">
          {industry.handsOff.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap prose">
      <h2>Which package</h2>
      <p>{industry.fit}</p>
      {industry.note && <p>{industry.note}</p>}
      {
        industry.slug === "home-services" && (
          <p>
            Trade pages: <a href="/industries/roofing">roofing</a>, <a href="/industries/hvac">HVAC</a>, <a href="/industries/pest-control">pest control</a>, and <a href="/industries/plumbing">plumbing</a>.
          </p>
        )
      }
      <p>
        <a class="text-link" href="/pricing">Pricing, add-ons, and the 14-day Starter pilot</a>
        · <a class="text-link" href="/how-it-works">How a setup actually runs</a>
      </p>
    </div>
  </section>
  <FinalCta />
</Base>
