---
import Base from "../layouts/Base.astro";
import CallExample from "../components/CallExample.astro";
import CtaPair from "../components/CtaPair.astro";
import DemoForm from "../components/DemoForm.astro";
import FaqList from "../components/FaqList.astro";
import FinalCta from "../components/FinalCta.astro";
import { faqJsonLd } from "../data/faq";
import { pillars } from "../data/services";
import { DEMO_LINE, site } from "../data/site";
import AvaSection from "../components/AvaSection.astro";

const title = "AI Receptionist & Automation for Miami | Launchline Design";
const description =
  "Done-for-you AI that answers, books, and follows up for Miami roofing, HVAC, plumbing, pest control, law firms, med spas, and dental practices. Free 14-day Starter pilot.";

const alternates = [
  { hreflang: "en", href: `${site.url}/` },
  { hreflang: "es", href: `${site.url}/es` },
  { hreflang: "x-default", href: `${site.url}/` },
];
---

<Base title={title} description={description} jsonLd={faqJsonLd()} alternates={alternates}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Miami · Done-for-you AI</p>
        <h1>AI that answers, books, and follows up, so your business <span class="accent">never misses a lead.</span></h1>
        <p class="lede">
          Launchline builds AI receptionists, follow-up, and the systems around them for Miami roofing, HVAC, plumbing, pest control, law firms, med spas, and dental practices. Set up for you, plugged into the tools you already use.
        </p>
        <CtaPair audit book={false} />
        <ul class="hero-points">
          <li>Free 14-day Starter pilot</li>
          <li>Live in as little as 7 days</li>
          <li>Usage billed at cost, no markup</li>
          <li>You keep your accounts and data</li>
        </ul>
      </div>
      <CallExample />
    </div>
    <svg class="wave" viewBox="0 0 1200 80" aria-hidden="true">
      <path
        d="M0 48H180l28-22 24 36 22-28 20 18h946"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
  </section>

  <nav class="pillar-strip" aria-label="Service pillars">
    <div class="wrap">
      {
        pillars.map((pillar, index) => (
          <a href={pillar.href}>
            <span>0{index + 1}</span>
            <strong>{pillar.name}</strong>
            <small>{pillar.note}</small>
          </a>
        ))
      }
    </div>
  </nav>

  <AvaSection loomHref="/#custom-demo" />

  <section class="section" aria-labelledby="problem-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The leak</p>
        <h2 id="problem-heading">Stop losing customers to voicemail.</h2>
        <p class="lede">No invented percentages. Just the calls Miami businesses already know they are dropping.</p>
      </div>
      <div class="problems">
        <article class="problem">
          <p class="idx">01</p>
          <strong>Missed calls go to your competitors.</strong>
          <p>A roofer on a Kendall roof and an HVAC tech in a hot attic do not hear the phone. The next company on the list does.</p>
        </article>
        <article class="problem">
          <p class="idx">02</p>
          <strong>After-hours inquiries go cold.</strong>
          <p>The consult, the toothache, the leak at 8pm. If nobody answers, they book whoever does.</p>
        </article>
        <article class="problem">
          <p class="idx">03</p>
          <strong>Your front desk is buried in repeat questions.</strong>
          <p>Hours, insurance, “do you have Thursday,” prices you already published. New leads wait behind them.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="solutions-heading" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The stack</p>
        <h2 id="solutions-heading">Four pillars, from the first search to the paid invoice.</h2>
        <p class="lede">Start with the missed call. Add the next piece when it pays for itself.</p>
      </div>
      <div class="cards quarters">
        {
          pillars.map((pillar, index) => (
            <a class="solution" href={pillar.href}>
              <span class="idx">0{index + 1}</span>
              <h3>{pillar.name}</h3>
              <p>{pillar.lede}</p>
              <span class="more">{pillar.note}</span>
            </a>
          ))
        }
      </div>
      <p class="small" style="margin-top: 1rem">
        <a class="text-link" href="/services">Every service, with price and launch time</a>
        {" · "}
        <a class="text-link" href="/ai-receptionist">The AI receptionist</a>
      </p>
    </div>
  </section>

  <section class="section" id="sample-loom" aria-labelledby="loom-slot-heading">
    <div class="wrap">
      <div class="slot">
        <p class="slot-kicker">Sample Loom · empty</p>
        <h2 id="loom-slot-heading">A recorded walkthrough will live here.</h2>
        <p style="margin-top: 0.6rem; max-width: 62ch">
          No sample Loom is published yet. Call Ava at <a class="text-link" href={DEMO_LINE.href}>{DEMO_LINE.display}</a>, or request one recorded on your own website.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="industries" aria-labelledby="industries-heading" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who it’s for</p>
        <h2 id="industries-heading">Built around how Miami businesses actually get called.</h2>
      </div>
      <div class="cards wide">
        <a class="industry-card" href="/industries/roofing">
          <span class="idx">Roofing</span>
          <h3>Storm-night leaks.</h3>
          <p>The inspection gets booked while the crew is still on a tile roof in Kendall.</p>
          <span class="more">Roofing coverage</span>
        </a>
        <a class="industry-card" href="/industries/hvac">
          <span class="idx">HVAC</span>
          <h3>No-cool, not a tune-up.</h3>
          <p>August calls get sorted. The emergency alerts you. The maintenance visit gets a window.</p>
          <span class="more">HVAC coverage</span>
        </a>
        <a class="industry-card" href="/industries/pest-control">
          <span class="idx">Pest control</span>
          <h3>Saturday swarmers.</h3>
          <p>The route keeps moving. The weekend call still gets a text or a booked stop.</p>
          <span class="more">Pest control coverage</span>
        </a>
        <a class="industry-card" href="/industries/plumbing">
          <span class="idx">Plumbing</span>
          <h3>Active leak or remodel.</h3>
          <p>The running leak reaches the on-call plumber. The kitchen quote gets a time next month.</p>
          <span class="more">Plumbing coverage</span>
        </a>
      </div>
      <div class="cards quarters" style="margin-top: 0.9rem">
        <a class="industry-card" href="/industries/home-services">
          <span class="idx">Home services</span>
          <h3>Emergency or estimate.</h3>
          <p>The same coverage, written for crews who cannot pick up. Roofing, HVAC, plumbing, and pest control.</p>
          <span class="more">All home services</span>
        </a>
        <a class="industry-card" href="/industries/law-firms">
          <span class="idx">Law firms</span>
          <h3>Intake, not advice.</h3>
          <p>After-hours questions you approve, including names for a conflict check. It books a consult. It does not practice law.</p>
          <span class="more">See legal intake</span>
        </a>
        <a class="industry-card" href="/industries/med-spas">
          <span class="idx">Med spas</span>
          <h3>Consults and rebooking.</h3>
          <p>The request that comes in after the front desk leaves still gets a time on the calendar.</p>
          <span class="more">See med spa coverage</span>
        </a>
        <a class="industry-card" href="/industries/dental">
          <span class="idx">Dental</span>
          <h3>Recalls and plan questions.</h3>
          <p>New-patient booking and insurance answers from a list you approve. No diagnosis.</p>
          <span class="more">See dental coverage</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">You approve every script before a customer hears it.</h2>
      </div>
      <ol class="steps four">
        <li class="step">
          <span class="step-num">1</span>
          <div>
            <h3>Discovery call</h3>
            <p>Fifteen minutes. We map how your phone actually rings and pick a package.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-num">2</span>
          <div>
            <h3>Custom build and integration</h3>
            <p>Scripts in your voice, connected to the calendar and tools you already use.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-num">3</span>
          <div>
            <h3>Test on your real calls</h3>
            <p>You hear it before customers do. Starter can run as a free 14-day pilot.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-num">4</span>
          <div>
            <h3>Launch and tune monthly</h3>
            <p>Live in as little as 7 days. Then we adjust from real conversations.</p>
          </div>
        </li>
      </ol>
      <p class="small" style="margin-top: 1.25rem">
        <a class="text-link" href="/how-it-works">The full setup, including the free Loom</a>
      </p>
    </div>
  </section>

  <section class="section" id="integrations" aria-labelledby="tools-heading" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Tools</p>
        <h2 id="tools-heading">It plugs into the stack you already pay for.</h2>
        <p class="lede">Booking lands on your calendar. Follow-up can reach your CRM. The exact connection is written into the quote.</p>
      </div>
      <ul class="pills" aria-label="Common systems discussed on the discovery call">
        <li>Google Calendar</li>
        <li>ServiceTitan</li>
        <li>Jobber</li>
        <li>Housecall Pro</li>
        <li>Clio</li>
        <li>GoHighLevel</li>
        <li>QuickBooks</li>
        <li>Stripe</li>
        <li>Cal.com</li>
        <li>Jane</li>
        <li>Vagaro</li>
        <li>Dentrix</li>
        <li>HubSpot</li>
      </ul>
      <p class="small" style="margin-top: 1rem; max-width: 62ch">
        Named here as common systems for these industries. A tool is connected only after the discovery call confirms you use it and the integration is in scope. These are not partnership badges.
        <a class="text-link" href="/integrations">How each connection is scoped</a>
      </p>
    </div>
  </section>

  <section class="section" id="custom-demo" aria-labelledby="loom-heading">
    <div class="wrap loom-grid">
      <div>
        <p class="eyebrow">Personalized Loom</p>
        <h2 id="loom-heading">Want to see it on your business?</h2>
        <p class="lede">
          Send your website and we’ll record a free Loom showing exactly how AI would handle your calls and leads. It is a free, personalized 2-minute Loom. No slide deck.
        </p>
        <p class="small" style="margin-top: 1rem">
          Prefer to talk first? Call {site.founder} at <a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a> or email <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <DemoForm id="home-demo-form" />
    </div>
  </section>

  <section class="section" aria-labelledby="founder-heading" style="padding-top: 0">
    <div class="wrap">
      <div class="founder-note">
        <div>
          <p class="eyebrow">The person who builds it</p>
          <h2 id="founder-heading">Small or large, you work directly with the engineer.</h2>
        </div>
        <div class="stack">
          <p>
            {site.founder} founded Launchline Design in Miami. He also runs {site.otherBusiness}, a Miami home services business, so the missed-call problem is not a slide in a deck.
          </p>
          <p>
            There is no account-manager layer on the other side of the kickoff. The person who scopes the script is the person who ships it, then tunes it after real calls.
          </p>
          <p>
            <a class="text-link" href="/about">More about Myles</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-heading" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">Privacy, recording, handoff, price, and timing.</h2>
      </div>
      <FaqList />
    </div>
  </section>

  <FinalCta />
</Base>
