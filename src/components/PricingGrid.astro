---
import { addons, pilot, pricingNotes, tiers } from "../data/pricing";

interface Props {
  showAddons?: boolean;
}

const { showAddons = true } = Astro.props;
---

<div class="tiers">
  {
    tiers.map((tier) => (
      <article class:list={["tier", tier.featured && "featured"]}>
        {tier.featured && <p class="badge">Most popular</p>}
        <p class="tier-step">{tier.step}</p>
        <h3 style="margin-top: 0.3rem">{tier.name}</h3>
        <p>{tier.pitch}</p>
        <div class="price-row">
          <p>
            <span>Setup</span>
            <strong class="amt">{tier.setup}</strong>
          </p>
          <p>
            <span>Monthly</span>
            <strong class="amt">{tier.monthly}</strong>
          </p>
        </div>
        <ul class="ticks">
          {tier.items.map((item) => (
            <li class:list={[item.lead && "lead"]}>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                {item.lead ? (
                  <path fill="currentColor" d="M7.2 3h1.6v4.2H13v1.6H8.8V13H7.2V8.8H3V7.2h4.2V3z" />
                ) : (
                  <path fill="none" stroke="currentColor" stroke-width="1.8" d="M3 8.2 6.2 11.5 13 4.5" />
                )}
              </svg>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
        <div class="fit">
          <p>
            <strong style="color: white">Best for: </strong>
            {tier.fit}
          </p>
        </div>
      </article>
    ))
  }
</div>

{
  showAddons && (
    <div class="bottom-grid" style="margin-top: 1rem">
      <section class="panel" aria-labelledby="addons-heading">
        <p class="eyebrow" id="addons-heading">Add-ons</p>
        <p class="small" style="margin-bottom: 0.4rem">Setup · monthly, unless noted</p>
        <ul class="addon-list">
          {addons.map((addon) => (
            <li>
              <div>
                <strong>{addon.name}</strong>
                <span class="small">{addon.detail}</span>
              </div>
              <span class="addon-price">{addon.price}</span>
            </li>
          ))}
        </ul>
      </section>
      <div class="side-stack">
        <section class="panel" aria-labelledby="menu-steps">
          <p class="eyebrow" id="menu-steps">How a package starts</p>
          <ol class="steps" style="margin-top: 0.4rem">
            <li class="step">
              <span class="step-num">1</span>
              <p><strong style="color: white">Free demo.</strong> You’ve seen your personalized Loom.</p>
            </li>
            <li class="step">
              <span class="step-num">2</span>
              <p><strong style="color: white">15-minute call.</strong> We pick a package and map your calls.</p>
            </li>
            <li class="step">
              <span class="step-num">3</span>
              <p><strong style="color: white">Live in as little as 7 days.</strong> You approve every script.</p>
            </li>
          </ol>
        </section>
        <section class="pilot">
          <p class="slot-kicker">{pilot.kicker}</p>
          <h3>{pilot.title}</h3>
          <p>{pilot.text}</p>
        </section>
      </div>
    </div>
  )
}

<ul class="plain-list small" style="margin-top: 1rem">
  {pricingNotes.map((note) => <li>{note}</li>)}
</ul>
