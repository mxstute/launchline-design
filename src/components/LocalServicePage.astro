---
import CtaPair from "./CtaPair.astro";
import FinalCta from "./FinalCta.astro";
import PageHero from "./PageHero.astro";
import Base from "../layouts/Base.astro";
import { complianceLine, getLocalPage, getPillar, getService, ownershipLine } from "../data/services";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const page = getLocalPage(slug);
if (!page) {
  throw new Error(`Unknown local page: ${slug}`);
}
const service = getService(page.serviceId);
const pillar = getPillar(service.pillar);
---

<Base title={page.title} description={page.description}>
  <PageHero eyebrow={page.eyebrow} title={page.h1} lede={page.lede} crumbs={[
    { href: "/", label: "Home" },
    { href: "/services", label: "Services" },
    { href: pillar.href, label: pillar.name },
    { href: `/${page.slug}`, label: service.name },
  ]}>
    <CtaPair audit />
  </PageHero>

  <section class="section">
    <div class="wrap stack" style="max-width: 44rem">
      {page.story.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <article class="panel service-block">
        <div>
          <h2>{service.name}</h2>
          <p>{service.outcome}</p>
          <p class="service-meta">
            <span>{service.price}</span>
            <span>{service.launch}</span>
          </p>
        </div>
        <div>
          <h3>What’s included</h3>
          <ul class="plain-list">
            {service.included.map((line) => <li>{line}</li>)}
          </ul>
          <p><strong>Tools. </strong>{service.tools}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap prose">
      <p>{ownershipLine}</p>
      <p>{complianceLine}</p>
      <p>
        <a class="text-link" href={pillar.href}>More in {pillar.name}</a>
        {" · "}
        <a class="text-link" href="/pricing">Pricing</a>
      </p>
    </div>
  </section>
  <FinalCta />
</Base>
