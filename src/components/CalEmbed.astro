---
import { calLink, site } from "../data/site";

const link = calLink();
---

{
  link ? (
    <div class="cal-live" id="cal-embed" />
    <script is:inline define:vars={{ link }}>
      (function (C, A, L) {
        var p = function (a, ar) {
          a.q.push(ar);
        };
        var d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            var cal = C.Cal;
            var ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              var api = function () {
                p(api, arguments);
              };
              var namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "launchline", { origin: "https://cal.com" });
      Cal.ns.launchline("inline", {
        elementOrSelector: "#cal-embed",
        calLink: link,
        config: { layout: "month_view" },
      });
      Cal.ns.launchline("ui", {
        styles: { branding: { brandColor: "#2563EB" } },
        layout: "month_view",
      });
    </script>
  ) : (
    <div class="cal-frame" id="book">
      <p class="slot-kicker">Scheduler placeholder</p>
      <h3 style="margin: 0.4rem 0 0.6rem">The calendar embed is not connected yet.</h3>
      <p>
        Book the 15-minute strategy call directly with Myles. Call{" "}
        <a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>{" "}
        or email{" "}
        <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <p class="dev-note">
        Set <code>PUBLIC_CAL_LINK</code> to a Cal.com path such as <code>myles-stute/15min</code>, then rebuild.
        This panel becomes the live embed.
      </p>
    </div>
  )
}
