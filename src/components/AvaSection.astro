---
import { DEMO_LINE, site } from "../data/site";

interface Props {
  loomHref?: string;
}

const { loomHref = "/demo#custom-demo" } = Astro.props;

const features = [
  {
    title: "Picks up within seconds",
    text: "Ava answers every call, 24/7, within seconds. Nights, weekends, and the hour your crew is on a roof.",
  },
  {
    title: "A natural voice",
    text: "She sounds like a person, not a phone tree. You can judge that yourself on this call.",
  },
  {
    title: "English and Spanish",
    text: "She is fluent in both and switches when the caller does. On a client line, bilingual coverage is included in Custom and is an add-on on Starter and Growth.",
  },
  {
    title: "She books the visit",
    text: "Ava captures the caller’s name, phone, email, and preferred time, and offers an appointment.",
  },
  {
    title: "A summary after every call",
    text: "The business gets the caller’s details, what they need, and the follow-up action. Nobody replays a voicemail to find out.",
  },
];

const roles = [
  {
    name: "Roofing",
    ask: "Ask her to be a roofing company.",
    takes: "Address, the damage, how urgent it is, and photos by text.",
  },
  {
    name: "Pest control",
    ask: "Ask her to be a pest control company.",
    takes: "The pest, the property, and whether they want recurring service.",
  },
  {
    name: "Law firm",
    ask: "Ask her to be a law firm.",
    takes: "Accident details, the date, injuries, and whether they already have counsel. She never gives legal advice.",
  },
];
---

<section class="section ava-section" id="hear-it-live" aria-labelledby="ava-heading">
  <div class="wrap">
    <div class="ava-stage">
      <div class="ava-lead">
        <p class="eyebrow">Hear it live · This is the product</p>
        <h2 id="ava-heading">Call Ava. She is what clients get.</h2>
        <p class="lede">
          Ava is Launchline’s AI receptionist. This line is not a mockup. It is the same setup Launchline runs for its own home services business in Miami, {site.otherBusiness}. Call her and hear it before you book anything.
        </p>
        <p class="ava-number">
          <a href={DEMO_LINE.href}>{DEMO_LINE.display}</a>
        </p>
        <div class="cta-row">
          <a class="btn btn-mint ava-cta" href={DEMO_LINE.href}>Call Ava now · {DEMO_LINE.display}</a>
          <a class="btn btn-ghost" href={loomHref}>Get a Loom on my site</a>
        </div>
        <p class="ava-prompt">Try asking her to be your business.</p>
        <p class="small">
          She will also role-play a roofing company, a pest control company, or a law firm. Or just ask her about Launchline.
          This number is Ava. To reach {site.founder}, call <a class="text-link" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>.
        </p>
      </div>

      <ul class="ava-features">
        {
          features.map((feature) => (
            <li>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="ava-roles" aria-label="What to ask Ava">
        {
          roles.map((role) => (
            <article>
              <p class="slot-kicker">{role.name}</p>
              <h3>{role.ask}</h3>
              <p>{role.takes}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
