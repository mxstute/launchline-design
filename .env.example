# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables, then redeploy.
# Public variables are baked in at build time.

# Optional overrides. Leave blank to use the defaults in src/data/site.ts.
# Form default: https://formspree.io/f/xvzvrpow
# The form POSTs name, business, website, email, phone, notes, source,
# _subject, and a _gotcha honeypot. _next is https://www.launchlinedesign.com/thanks.
PUBLIC_DEMO_FORM_ENDPOINT=

# Cal.com path only, not the full URL.
# Default: myles-stute-v7irmp (profile; the visitor picks the event).
# An event override looks like myles-stute-v7irmp/15min.
PUBLIC_CAL_LINK=

# Optional street address for the footer and LocalBusiness schema.
# Leave blank to publish Miami, FL and the Miami-Dade service area only.
PUBLIC_STREET_ADDRESS=
