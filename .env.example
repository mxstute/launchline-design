# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables, then redeploy.
# Public variables are baked in at build time.

# Formspree endpoint for the "Get my custom demo" form. Leave blank and the
# site still builds: the submit button stays disabled and email/phone work.
# Example: https://formspree.io/f/xxxxxxxx
# The form POSTs here. It includes _next (https://www.launchlinedesign.com/thanks),
# _subject, source, and a _gotcha honeypot. JavaScript also sends visitors to /thanks.
PUBLIC_DEMO_FORM_ENDPOINT=

# Cal.com event path only, not the full URL. Leave blank for a phone/email panel
# instead of an embed. Example: myles-stute/15min
PUBLIC_CAL_LINK=

# Optional street address for the footer and LocalBusiness schema.
# Leave blank to publish Miami, FL and the Miami-Dade service area only.
PUBLIC_STREET_ADDRESS=
